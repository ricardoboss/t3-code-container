# Existing dedicated Linux host directory, owned by UID/GID 1000.
T3_WORKSPACE_DIR=/srv/t3-workspace
# T3_IMAGE=ghcr.io/ricardoboss/t3-code-container:v1
# T3_HOSTNAME=homelab

# Optional limits are ceilings, not reservations. Shown values are the defaults.
# T3_CPUS=4
# T3_MEMORY=8g
# T3_PIDS_LIMIT=4096
# T3_SHM_SIZE=512m
# T3_BUILD_JOBS=2
# T3_LOG_LEVEL=Info
# Healthcheck grace period for initial SDK/harness provisioning, not a startup timeout.
# T3_START_PERIOD=15m

# Only used with compose.docker.yaml.
# T3_DOCKER_CPUS=4
# T3_DOCKER_MEMORY=8g
