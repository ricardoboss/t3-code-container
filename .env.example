# Existing dedicated Linux host directory, owned by UID/GID 1000.
T3_WORKSPACE_DIR=/srv/t3-workspace
# T3_IMAGE=ghcr.io/ricardoboss/t3-code-container:v1
# T3_HOSTNAME=homelab

# Limits are ceilings, not reservations. Tune after measuring your workload.
T3_CPUS=4
T3_MEMORY=8g
T3_PIDS_LIMIT=4096
T3_SHM_SIZE=512m
T3_BUILD_JOBS=2
T3_LOG_LEVEL=Info
# First startup downloads and verifies SDKs/harnesses before starting T3.
T3_START_PERIOD=15m

# Only used with compose.docker.yaml.
T3_DOCKER_CPUS=4
T3_DOCKER_MEMORY=8g

# Tool versions are pinned in versions.env. Base image overrides are optional:
# NODE_IMAGE=node:VERSION-trixie-slim@sha256:DIGEST
# DOCKER_CLI_IMAGE=docker:VERSION-cli@sha256:DIGEST
# DOCKER_DAEMON_IMAGE=docker:VERSION-dind@sha256:DIGEST
